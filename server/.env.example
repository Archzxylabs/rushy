# Free local Rushy server. Wallet and escrow configuration are not needed.
HOST=127.0.0.1
PORT=5174
PUBLIC_ORIGIN=http://localhost:5174
DATABASE_PATH=./data/rushy.sqlite
# Split hosting may additionally set PUBLIC_WS_ADDRESS and ADDITIONAL_ALLOWED_ORIGINS.
# The paid Arc mainnet flow is deployed (PaidDuelEscrow, HouseCupEscrow) but is opt-in:
# Set these only on a host that is meant to move real USDC. A plain local run
# needs none of them. Local mock mode uses LOCAL_MOCK_RPC_URL and a 127.0.0.1 RPC.
# ENABLE_ARC_PRIZES=1
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# CUP_ESCROW_ADDRESS=0x38C8093907f6085e7c2Ad22335F3f4DA15466Efe
# DUEL_ESCROW_ADDRESS=0xA6505430759EabF189b275251F72FDD357B0Abdc
# DUEL_FEE_BPS=500
# DUEL_TREASURY_ADDRESS=0xEA2d8827B331C80649353f6f28525d10bfa44796
# RESULT_SIGNER_PRIVATE_KEY=
# RELAY_PRIVATE_KEY=
# See ../docs/deploy-railway.md for hosting, persistence, and required signer roles.
